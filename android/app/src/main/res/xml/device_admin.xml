<?xml version="1.0" encoding="utf-8"?>
<!--
  Device admin policy Guard.

  PENTING: daftar ini bukan "request" - ini capability yang device owner
  declares. DevicePolicyManager hanya mengizinkan resetPassword, lockNow,
  wipeData, setCameraDisabled, setPasswordQuality, dll. UNTUK app yang
  SUDAH menjadi Device Owner (lihat GuardDeviceAdminReceiver.onEnabled).

  disable-camera tetap false di sini; matikan/toggle dilakukan lewat
  DevicePolicyManager.setCameraDisabled() dari server.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <expire-password />
        <disable-camera />
        <disable-keyguard />
        <encrypted-storage />
        <limit-storage />
    </uses-policies>
</device-admin>