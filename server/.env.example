# ============================================================================
# FLEET GUARD - konfigurasi server broker (PC lokal)
# Salin ke .env lalu isi. JANGAN pernah commit .env
# ============================================================================

# --- Identitas server -------------------------------------------------------
NODE_ENV=production
SERVER_NAME=fleet-guard-pc-01
# Port internal (TLS termination biasanya di Caddy/cloudflared, bukan di sini)
HTTP_PORT=8787
# Dipakai untuk membuat URL QR/NFC enrollment dan URL media device
PUBLIC_BASE_URL=https://fleet.example.my.id

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Whitelist chat_id (pisahkan koma). Kosong = hanya dari DB admin_users
ADMIN_CHAT_IDS=
# Nama grup opsional untuk laporan alarm geofence (format -100xxxxxxxxxx)
ALERT_GROUP_CHAT_ID=

# --- Keamanan (JANGAN KOSONGKAN - server auto-generate di .data/keyring.json) -
# Base64 32 byte untuk AES-256-GCM (enkripsi data at rest)
DATA_KEY=
# Untuk HMAC pepper token device & session
PEPPER=
# Password admin dashboard (dipakai scripts/admin.mjs)
ADMIN_PASSWORD=

# --- Database ---------------------------------------------------------------
# sqlite (default, file lokal) ATAU postgres untuk VPS:
#   DATABASE_URL=postgres://user:pass@localhost:5432/fleetguard
DATABASE_URL=sqlite:./data/fleetguard.db

# --- Runtime ----------------------------------------------------------------
# Interval heartbeat device yang dikirim server (ms)
HEARTBEAT_INTERVAL_MS=30000
# Device dianggap offline kalau diam lebih dari ini (ms)
OFFLINE_AFTER_MS=90000
# Batas antrean command per device
QUEUE_MAX_DEPTH=40
# Umum TTL command (ms)
COMMAND_DEFAULT_TTL_MS=60000
# Hapus location_history yang lebih tua dari N hari
LOCATION_RETENTION_DAYS=180
# Media (foto) disimpan di
MEDIA_DIR=./data/media

# --- Logging ----------------------------------------------------------------
# Level minimum: debug | info | warn | error
LOG_LEVEL=info
# Tulis log ke console? false = hemat resource saat jalan sebagai Windows Service
LOG_CONSOLE=true
# Ke mana console menulis: stdout (default, disarankan) | stderr
# Jangan pilih "stderr" di Windows: log warning akan hilang saat di-redirect.
LOG_CONSOLE_DEST=stdout

# --- Zero-Touch / Enrollment (untuk generate payload QR & NFC) -------------
# https://androidmanagement.googleapis.com/v1/enterprises/{id}/policies/default
AMAPI_POLICY_NAME=
# enrollmentToken dari enterprises.enrollmentTokens.create
AMAPI_ENROLLMENT_TOKEN=
# package DeviceAdminReceiver milik Guard (DPC custom)
# Format: <applicationId>/<package>.<NamaReceiver> - WAJIB persis.
GUARD_DPC_COMPONENT=id.acefleet.guard/id.acefleet.guard.GuardDeviceAdminReceiver
# SHA1 (base64) dari sertifikat signing Guard - wajib benar agar device
# menerima enrollment DPC custom.
GUARD_DPC_SIGNATURE_SHA1=
